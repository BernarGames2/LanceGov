{
  "name": "lancegov-video",
  "private": true,
  "description": "Vídeo \"Como a LanceGov funciona\" (Remotion). Renderiza para public/video/.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ComoFunciona out/como-funciona-master.mp4 --codec=h264 --crf=18 && node scripts/encode-web.mjs",
    "poster": "remotion still ComoFunciona ../public/video/como-funciona-poster.jpg --frame=90 --image-format=jpeg --jpeg-quality=85 --scale=0.6667",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
